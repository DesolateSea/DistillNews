# Microsoft Foundry via the OpenAI-compatible API-key endpoint.
AGENT_PROVIDER=openai
FOUNDRY_API_KEY=replace-with-your-foundry-api-key
FOUNDRY_BASE_URL=https://distillnews-foundry.openai.azure.com/openai/v1/
# Use the model deployment name shown in Foundry.
FOUNDRY_MODEL=gpt-4o-mini

# RAG Backend (options: openai, foundry, julep, none)
RAG_BACKEND=openai
# FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# The generic names remain supported for OpenAI-compatible providers.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AGENT_MODEL=
# OPENAI_EMBEDDING_MODEL=

# Backend runtime settings
DB_URL=mongodb://mongo:27017/evolution
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Frontend container build settings
NEXT_PUBLIC_API_URL=http://localhost:8000
OPENWEATHER_API_KEY=replace-with-your-openweather-key
