# Agent Provider (options: openai, ollama, huggingface, julep)
AGENT_PROVIDER=openai
FOUNDRY_API_KEY=replace-with-your-foundry-api-key
FOUNDRY_BASE_URL=https://distillnews-foundry.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-4o-mini

# RAG Backend (options: openai, foundry, ollama, huggingface, julep, none)
RAG_BACKEND=openai
# FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama Settings (when AGENT_PROVIDER=ollama or RAG_BACKEND=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# HuggingFace Settings (when AGENT_PROVIDER=huggingface or RAG_BACKEND=huggingface)
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Backend runtime settings
DB_URL=mongodb://mongo:27017/evolution
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Frontend container build settings
NEXT_PUBLIC_API_URL=http://localhost:8000
OPENWEATHER_API_KEY=replace-with-your-openweather-key

# Email service settings
EMAIL=your-email@gmail.com
PASS=your-gmail-app-password
REDIS_URL=redis://redis:6379/0
