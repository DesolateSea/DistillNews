# Agent Provider (options: openai, ollama, huggingface, julep)
AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o-mini

# OpenAI / Azure Foundry Settings
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

FOUNDRY_API_KEY=replace-with-your-foundry-api-key
FOUNDRY_BASE_URL=https://distillnews-foundry.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-4o-mini
# FOUNDRY_EMBEDDING_MODEL=your-foundry-embedding-deployment

# Julep Settings (when AGENT_PROVIDER=julep or RAG_BACKEND=julep)
# JULEP_API_KEY=your-julep-api-key
# JULEP_MODEL=claude-3.5-sonnet
# JULEP_ENVIRONMENT=production

# Retrieval and Embeddings
# RAG_BACKEND options: memory, julep, none
# EMBEDDING_PROVIDER options: openai, foundry, ollama, sentence_transformers, huggingface, none
# The provider is used only when RAG_BACKEND=memory.
RAG_BACKEND=memory
EMBEDDING_PROVIDER=sentence_transformers

# Local Ollama Settings (when AGENT_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local Sentence Transformers Settings (when EMBEDDING_PROVIDER=sentence_transformers)
# The model downloads once and is then loaded from the local model cache.
# SENTENCE_TRANSFORMERS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SENTENCE_TRANSFORMERS_DEVICE=cpu

# HuggingFace Settings (when AGENT_PROVIDER=huggingface or EMBEDDING_PROVIDER=huggingface)
# HUGGINGFACE_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pipeline Source & Service Controls
# Options: reddit, rapid_news, gnews, media_stack, news_org, core, scrape
# Comma-separated list to disable specific services:
# DISABLED_PIPELINE_SOURCES=reddit,rapid_news,scrape
# Or explicitly define enabled services:
# ENABLED_PIPELINE_SOURCES=gnews,media_stack

# Pipeline News & Weather Data Source API Keys
CORE_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
NEWS_API_KEY=
RAPIDAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
OPENWEATHER_API_KEY=
# Example: Only run GNews and MediaStack
ENABLED_PIPELINE_SOURCES=gnews,media_stack
# Example: Disable Reddit, Rapid News, and Web Scraping
DISABLED_PIPELINE_SOURCES=reddit,rapid_news,scrape


# Backend & Database Runtime Settings
DB_URL=mongodb://mongo:27017/evolution
MONGODB_URL=mongodb://mongo:27017/evolution
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend & Email Link Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
WEBSITE_URL=http://localhost:3000
CLIENT=http://localhost:3000

# Email Service SMTP Settings
EMAIL=your-email@gmail.com
PASS=your-gmail-app-password

