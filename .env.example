# =====================================================================
# Development Options
# =====================================================================
DEBUG=true
PRODUCTION=false

# =====================================================================
# Agent & AI Provider Settings
# =====================================================================
# Agent Provider Options: openai, julep, ollama, huggingface
AGENT_PROVIDER=openai

# Microsoft Azure Foundry (OpenAI-compatible)
FOUNDRY_API_KEY=replace-with-your-foundry-api-key
FOUNDRY_BASE_URL=https://distillnews-foundry.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-4o-mini

# Standard OpenAI Settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Julep Settings (when AGENT_PROVIDER=julep or RAG_BACKEND=julep)
# JULEP_API_KEY=your-julep-api-key
# JULEP_MODEL=claude-3.5-sonnet

# Local Ollama Settings (when AGENT_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# HuggingFace Settings (when AGENT_PROVIDER=huggingface)
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# =====================================================================
# RAG & Embedding Settings
# =====================================================================
# RAG_BACKEND options: memory, julep, none
# EMBEDDING_PROVIDER options: sentence_transformers, openai, foundry, ollama, huggingface, none
RAG_BACKEND=memory
EMBEDDING_PROVIDER=sentence_transformers

# =====================================================================
# Pipeline Data Sources & API Keys
# =====================================================================
CORE_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
NEWS_API_KEY=
RAPIDAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
OPENWEATHER_API_KEY=

# Pipeline source controls (comma-separated list)
# Available sources: reddit, rapid_news, gnews, media_stack, news_org, core, scrape
# DISABLED_PIPELINE_SOURCES=reddit
# ENABLED_PIPELINE_SOURCES=gnews,media_stack

# =====================================================================
# Database
# =====================================================================
DB_URL=mongodb://mongo:27017/evolution
AZURE_STORAGE_CONNECTION_STRING=

# =====================================================================
# Website
# =====================================================================
PORT=8000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEBSITE_URL=http://localhost:3000

# =====================================================================
# Email Service (OTP Verification)
# =====================================================================
EMAIL=your-email@gmail.com
PASS=your-gmail-app-password
