/* TUI Styles */
Screen {
    background: #0d1117;
    color: #c9d1d9;
}

#app-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 35 1fr;
    grid-rows: 1fr 20;
    height: 100%;
    width: 100%;
}

#sidebar {
    background: #161b22;
    width: 100%;
    height: 100%;
    border-right: solid #30363d;
    padding: 1;
    row-span: 2;
}

#main-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#log-panel {
    width: 100%;
    height: 100%;
    border-top: solid #30363d;
    padding: 0 1;
    background: #0d1117;
}

.source-card {
    padding: 0 1;
    margin-bottom: 0;
    border: solid #30363d;
    background: #0d1117;
    height: 3;
}

.source-enabled {
    border-left: thick #3fb950;
}

.source-disabled {
    border-left: thick #8b949e;
    color: #8b949e;
}

.source-name {
    width: 1fr;
}

.source-status-on {
    color: #3fb950;
    text-style: bold;
    width: auto;
}

.source-status-off {
    color: #8b949e;
    text-style: bold;
    width: auto;
}

.stage-panel {
    margin-bottom: 2;
    height: auto;
}

.stage-label {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#article-count {
    text-style: bold;
    color: #e3b341;
    margin-top: 1;
    margin-bottom: 2;
}

Header {
    background: #161b22;
    color: #58a6ff;
}

Footer {
    background: #161b22;
    color: #c9d1d9;
}

ProgressBar {
    height: 1;
}

ProgressBar > .progress--bar {
    color: #3fb950;
    background: #3fb950;
}

ProgressBar > .progress--percentage {
    color: #c9d1d9;
}

ProgressBar > .progress--eta {
    color: #8b949e;
}

Button {
    width: 100%;
    margin-bottom: 1;
    background: #21262d;
    border: none;
    color: #c9d1d9;
    text-style: none;
}

Button:hover {
    background: #30363d;
}

Button:focus {
    text-style: bold;
    background: #30363d;
    color: #ffffff;
}

Button.-active {
    background: #30363d;
    text-style: bold;
}

Button.-primary {
    background: #1f6feb;
    color: #ffffff;
}

Button.-primary:hover {
    background: #388bfd;
}

Button.-primary:focus {
    background: #388bfd;
    color: #ffffff;
    text-style: bold;
}

Button.-primary.-active {
    background: #1553b7;
    color: #ffffff;
    text-style: bold;
}

Button.-success {
    background: #238636;
    color: #ffffff;
}

Button.-success:hover {
    background: #2ea043;
}

Button.-success:focus {
    background: #2ea043;
    color: #ffffff;
    text-style: bold;
}

Button.-success.-active {
    background: #1b6628;
    color: #ffffff;
    text-style: bold;
}

Button.-error {
    background: #da3633;
    color: #ffffff;
}

Button.-error:hover {
    background: #f85149;
}

Button.-error:focus {
    background: #f85149;
    color: #ffffff;
    text-style: bold;
}

Button.-error.-active {
    background: #b62324;
    color: #ffffff;
    text-style: bold;
}

RichLog {
    background: #0d1117;
    color: #c9d1d9;
}

/* Articles Screen */
#articles-screen {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 1fr;
    height: 100%;
    width: 100%;
}

#articles-table {
    height: 100%;
    border-right: solid #30363d;
}

#article-detail {
    height: 100%;
    padding: 1 2;
    background: #161b22;
}
